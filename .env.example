# Copy to .env for local cloud sync. Leave the values blank to keep words on this device only.
# These are the Firebase web app config fields. They are embedded in the built site;
# Firestore rules restrict every user to their own words.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
